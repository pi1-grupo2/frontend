# Copiar a .env y llenar.
# En Vite solo las variables con prefijo VITE_ llegan al navegador.
# Por lo mismo, aqui NUNCA va nada secreto: todo lo que empieza por VITE_
# queda visible en el bundle que se descarga el usuario.

# En local: http://127.0.0.1:8000/api
# En produccion: la URL de la API en Render, terminada en /api
VITE_API_URL=http://127.0.0.1:8000/api
